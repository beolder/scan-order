# SQLite database (relative to prisma/ when using file:./)
DATABASE_URL="file:./dev.db"

# Merchant demo login
MERCHANT_USERNAME="merchant"
MERCHANT_PASSWORD="demo1234"
SESSION_SECRET="change-me-to-a-long-random-string"

# Public base URL for table QR deep links
APP_BASE_URL="http://localhost:3000"

# Mock / sandbox payment adapter keys (demo — replace when plugging real SDKs)
WECHAT_PAY_MOCK_KEY="wechat-mock-key"
ALIPAY_MOCK_KEY="alipay-mock-key"

# Set true to simulate payment failure (order stays pending_pay)
PAYMENT_FORCE_FAIL="false"

